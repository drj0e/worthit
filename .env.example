# Optional. Read-only GitHub API access raises rate limits during inspection.
GITHUB_TOKEN=

# Required to execute third-party code with the local rootful-runc backend.
# Read docs/v1-runner.md before opting in.
WORTHIT_ALLOW_RUNC=0

# Runtime limits.
WORTHIT_MAX_RAM=2g
WORTHIT_MAX_CPUS=2
WORTHIT_MAX_PIDS=256
WORTHIT_MAX_WORKSPACE=1g
WORTHIT_MAX_OUTPUT_BYTES=262144
WORTHIT_MAX_INSTALL_SECONDS=600
WORTHIT_MAX_TEST_SECONDS=120
WORTHIT_MAX_RETRIES=2

# Daily selection and model spend ceilings.
DAILY_TEST_LIMIT=5
WORTHIT_DISCOVERY_LIMIT=80
WORTHIT_QUALIFY_LIMIT=10
MAX_LLM_COST_PER_REPO=5
MAX_TOTAL_DAILY_LLM_COST=25
